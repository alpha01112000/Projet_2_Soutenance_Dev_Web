# Configuration de la base de données
MONGODB_URI=mongodb://localhost:27017/agrilink

# Configuration JWT
JWT_SECRET=votre-secret-jwt-tres-securise-ici
JWT_EXPIRE=24h

# Configuration Admin
ADMIN_EMAIL=admin@agrilink.com
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=agrilink-admin-secret-2024

# Token de développement (optionnel)
DEV_TOKEN=votre-token-de-developpement-ici

# Configuration Cloudinary (si utilisé)
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# Configuration Email (si utilisé)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-mot-de-passe-app

# Port du serveur
PORT=5000

# Mode de développement
NODE_ENV=development
